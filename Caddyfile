http://gritsenko.me {
    @browser header_regexp User-Agent (?i)(mozilla|chrome|safari|firefox|edg)
    handle @browser {
        redir https://{host}{uri} 308
    }

    handle {
        reverse_proxy ipshow:8080 {
            header_up X-Forwarded-For {remote_host}
            header_up -X-Real-IP
        }
    }
}

